{
  "name": "ai-anki-desktop",
  "productName": "AI Anki",
  "version": "2.0.0",
  "description": "AI Anki — десктопный клиент: интервальные повторения с ИИ-экзаменатором",
  "main": "src/main.js",
  "author": "werwolf",
  "license": "MIT",
  "scripts": {
    "build:renderer": "npm --prefix ../web run build && node scripts/copy-renderer.js",
    "start": "npm run build:renderer && electron .",
    "dev": "electron . --dev-url=http://localhost:5173",
    "icon": "python scripts/make_icon.py",
    "dist": "npm run build:renderer && electron-builder --win"
  },
  "devDependencies": {
    "electron": "^44.9.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "ru.webmastermsk.aianki",
    "productName": "AI Anki",
    "copyright": "© 2026 werwolf",
    "directories": { "output": "dist" },
    "files": ["src/**/*", "renderer/**/*", "assets/**/*", "package.json"],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AI Anki",
      "artifactName": "AI-Anki-Setup-${version}.${ext}"
    }
  }
}
